@using Sandbox.Data
@using Sandbox.Enums
@using Sandbox.Managers
@inherits PanelComponent

<root class="@(IsOpen ? "" : "hidden")">
	@if (IsOpen && GetPlayerData() != null)
	{
		int TotalQuestsCount = GlobalData.Instance.AllQuestsData.Count;
		int CompletedQuestsCount = GlobalData.Instance.AllQuestsData.Count(Quest => Data.IsQuestCompleted(Quest.Key));
		<div class="menu-backdrop">
			<div class="menu-window">
				<div class="menu-header">
					<div class="header-left">
						<span class="title">QUESTS</span>
					</div>
					<div class="header-center">
						<span class="total-counter">COMPLETED: @CompletedQuestsCount / @TotalQuestsCount</span>
					</div>
					<div class="header-right">
						<button class="header-btn claim-all" onclick=@ClaimAllAvailableRewards>CLAIM ALL</button>
						<button class="header-btn close" onclick=@CloseMenu>✕</button>
					</div>
				</div>
				<div class="quests-scroll-list">
					@foreach (KeyValuePair<EQuest, QuestData> Quest in GlobalData.Instance.AllQuestsData)
					{
						int CurrentProgress = Data.GetQuestProgress(Quest.Key);
						bool IsCompleted = Data.IsQuestCompleted(Quest.Key);
						bool IsClaimed = Data.IsQuestClaimed(Quest.Key);
						bool CanClaim = IsCompleted && !IsClaimed;
						float ProgressPercent = (float)CurrentProgress / Quest.Value.RequiredProgress * 100f;
						<div class="quest-row @(IsCompleted ? "completed" : "")">
							<div class="quest-details">
								<span class="quest-name">@Quest.Key.ToString()</span>
								<span class="quest-description">@Quest.Value.QuestText</span>
								<div class="progress-container">
									<div class="progress-bar-bg">
										<div class="progress-bar-fill" style="width: @(ProgressPercent)%;"></div>
									</div>
									<span class="progress-text">@CurrentProgress / @Quest.Value.RequiredProgress</span>
								</div>
							</div>
							<div class="quest-actions">
								<div class="reward-badge">
									<i class="money-icon">payments</i>
									<span class="reward-value">+$@Quest.Value.RewardAmount.ToString("N0")</span>
								</div>
								@if (IsClaimed)
								{
									<button class="claim-btn claimed" disabled>CLAIMED</button>
								}
								else if (CanClaim)
								{
									<button class="claim-btn available" onclick=@(() => ClaimQuestReward(Quest.Key, Quest.Value.RewardAmount))>CLAIM</button>
								}
								else
								{
									<button class="claim-btn locked" disabled>LOCKED</button>
								}
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	private bool IsOpen;
	private int QuestUiStateHash;
	private PlayerData Data;

    protected override int BuildHash()
    {
	    PlayerData CurrentData = GetPlayerData();
	    if (CurrentData == null) return -1;
        return System.HashCode.Combine(QuestUiStateHash, IsOpen);
    }
    protected override void OnAwake()
    {
	    EventManager.OnUiStateChanged += UiStateChanged;
    }
    protected override void OnDestroy()
    {
	    EventManager.OnUiStateChanged -= UiStateChanged;
    }

    private PlayerData GetPlayerData()
    {
	    Data ??= EventManager.TriggerGetPlayerData();
	    return Data;
    }

    private void UiStateChanged(EUi InUi, bool RenderState)
    {
	    if (InUi != EUi.QuestMenu) return;
	    IsOpen = RenderState;
	    Panel?.Style.PointerEvents = IsOpen ? PointerEvents.All : PointerEvents.None;
    }
    private void RefreshMenuUiState() { QuestUiStateHash++; }
    private void ClaimQuestReward(EQuest InQuest, float InQuestReward)
    {
        Data.ClaimQuest(InQuest, InQuestReward);
        RefreshMenuUiState();
    }
    private void ClaimAllAvailableRewards()
    {
	    bool ClaimedAny = false;
	    foreach (KeyValuePair<EQuest, QuestData> Quest in GlobalData.Instance.AllQuestsData)
	    {
		    if (!Data.IsQuestCompleted(Quest.Key) || Data.IsQuestClaimed(Quest.Key)) continue;
		    Data.ClaimQuest(Quest.Key, Quest.Value.RewardAmount);
		    ClaimedAny = true;
	    }
	    if (ClaimedAny) RefreshMenuUiState();
    }
    private void CloseMenu() { UiManager.ChangeUiState(EUi.QuestMenu); }
}
