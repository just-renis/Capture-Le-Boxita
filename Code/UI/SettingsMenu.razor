@using Sandbox.Data
@using Sandbox.Enums
@using Sandbox.Managers
@inherits PanelComponent

<root class="@(IsOpen ? "" : "hidden")">
	@if (IsOpen && GetPlayerData() != null)
	{
		<div class="menu-box">
			<div class="x-close" onclick="@CloseMenu">X</div>
			<div class="header">SETTINGS</div>
			<div class="content">
				<div class="section">
					<label>YOUR NAME</label>
					<TextEntry Value:bind="@Data.Name" MaxLength=@(19) @OnTextEdited=@OnPlayerNameChanged/>
					<label class="hint">Min: 3 Characters, Max: 19 Characters</label>
				</div>
				<div class="section row">
					<div class="custom-checkbox @(Data.ShowNameTag ? "checked" : "")" onclick=@ToggleNameTag>
						<div class="check-inner"></div>
					</div>
					<label>SHOW NAME TAG FOR YOU</label>
				</div>
			</div>
			<div class="footer">
				<button class="btn-tutorial" onclick="@OpenTutorial">OPEN TUTORIAL MENU</button>
				<button class="btn-quit" onclick="@OpenDefaultSboxSettings">OPEN DEFAULT S&BOX SETTINGS</button>
			</div>
			<button class="btn-small-exit" onclick="@ExitGame">EXIT GAME</button>
		</div>
	}
</root>

@code
{
	private bool IsOpen;
	private PlayerData Data; 

	protected override int BuildHash()
	{
		PlayerData CurrentData = GetPlayerData();
		if (CurrentData == null) return -1;
		return System.HashCode.Combine(CurrentData.GetName(), CurrentData.GetShowNameTag(), IsOpen);
	}
	protected override void OnAwake()
	{
		EventManager.OnUiStateChanged += UiStateChanged;
	}
	protected override void OnDestroy()
	{
		EventManager.OnUiStateChanged -= UiStateChanged;
	}

	private PlayerData GetPlayerData()
	{
		Data ??= EventManager.TriggerGetPlayerData();
		return Data;
	}
	
	private void UiStateChanged(EUi InUi, bool RenderState)
	{
		if (InUi != EUi.SettingsMenu) return;
		IsOpen = RenderState;
		Panel?.Style.PointerEvents = IsOpen ? PointerEvents.All : PointerEvents.None;
	}
	private void ToggleNameTag()
	{
		Data.SetShowNameTag(!Data.ShowNameTag);
	}
	private void OnPlayerNameChanged(string InValue)
	{
		if (InValue.Length >= 3) Data.ChangeName(InValue);
	}
	private void CloseMenu() { UiManager.ChangeUiState(EUi.SettingsMenu); }
	private void ExitGame() { Game.Close(); }
	private void OpenDefaultSboxSettings() { Game.Overlay.ShowPauseMenu(); }
	private void OpenTutorial()
	{
		if (UiManager.IsUiOpen(EUi.TutorialMenu)) return;
		CloseMenu();
		UiManager.ChangeUiState(EUi.TutorialMenu);
	}
}
