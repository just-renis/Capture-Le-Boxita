@using Sandbox;
@using Sandbox.Enums
@using Sandbox.Managers
@inherits PanelComponent
@using System;
@using Sandbox.Data

<root>
	@if (PlayerData != null)
	{
		<div class="wrapper">
			<!-- Header -->
			<header>
				<div class="header-left">
					<div class="logo-box">
						<i>emoji_events</i>
					</div>
					<div class="title-info">
						<h1>SKILL TREE</h1>
					</div>
				</div>

				<div class="header-right">
					<div class="money-info">
						<span>AVAILABLE MONEY</span>
						<div class="money-amount">
							<i>savings</i>
							<span>$@PlayerData.GetMoney().ToString("F0")</span>
						</div>
					</div>
					<div class="code-btn" @onclick=@CloseMenu>
						<i>close</i>
					</div>
				</div>
			</header>

			<!-- Canvas Workspace -->
			<div class="canvas-container">
				<!-- Background Drag Catcher (Removed mouse up/move from here, handled safely in OnUpdate) -->
				<div class="canvas-bg" @onmousedown=@OnMouseDragged @onmouseup=@OnMouseReleased></div>

				<!-- Transformable Canvas View -->
				<div class="canvas" style="transform: translate(@(CanvasX)px, @(CanvasY)px) scale(@Scale);">
					<!-- Connection Lines -->
					<div class="lines">
						@foreach (Upgrade Node in Upgrades)
						{
							bool IsUpgradeOwned = GetIsOwned(Node.UpgradeName);
							bool IsAvailable = GetIsAvailable(Node.UpgradeName);
							bool IsDiscoverable = !IsUpgradeOwned && Node.ParentsUpgradeNames.Any(GetIsAvailable);
							if (!IsUpgradeOwned && !IsAvailable && !IsDiscoverable) continue;
							@foreach (EUpgradeName ParentId in Node.ParentsUpgradeNames)
							{
								Upgrade Parent = Upgrades.FirstOrDefault(U => U.UpgradeName == ParentId);
								if (Parent == null) continue;
								float Dx = Node.X - Parent.X;
								float Dy = Node.Y - Parent.Y;
								float Length = MathF.Sqrt(Dx * Dx + Dy * Dy);
								float Angle = MathF.Atan2(Dy, Dx) * 180f / MathF.PI;
								bool IsOwnedPath = IsUpgradeOwned && GetIsOwned(Parent.UpgradeName);
								<div class="line @(IsOwnedPath ? "owned" : "unowned")"
								     style="left: @(Parent.X + 32)px; top: @(Parent.Y + 32)px; width: @(Length)px; transform: rotate(@(Angle)deg);"></div>
							}
						}
					</div>
					<!-- Upgrade Nodes -->
					<div class="nodes">
						@foreach (Upgrade Node in Upgrades)
						{
							bool IsUpgradeOwned = GetIsOwned(Node.UpgradeName);
							bool IsAvailable = GetIsAvailable(Node.UpgradeName);
							bool IsDiscoverable = !IsUpgradeOwned && !IsAvailable && Node.ParentsUpgradeNames.Any(GetIsAvailable);
							if (!IsAvailable && !IsDiscoverable) continue;
							bool IsSelected = SelectedUpgradeName == Node.UpgradeName;
							string BackgroundStyle = "background-color: black;";
							if (!IsDiscoverable)
							{
								if (!CanBuyMore(Node)) BackgroundStyle = "background-color: #FFFF00BF;";
								else if (CanAfford(Node)) BackgroundStyle = "background-color: #41D34D;";
								else BackgroundStyle = "background-color: #C92121;";
							}
							<div class="node-wrapper @(IsSelected ? "selected" : "")" style="left: @(Node.X)px; top: @(Node.Y)px;"
							     @onclick=@(IsDiscoverable ? null : () => SelectNode(Node.UpgradeName))>
								<div class="node @(IsUpgradeOwned ? "owned" : "") @(IsAvailable ? "available" : "locked")" style="@BackgroundStyle">
									<img src="@(IsDiscoverable ? QuestionMarkIcon : Node.Icon)" alt=""/>
									@if (Node.MaxAmount > 1)
									{
										<div class="level-badge">@GetLevel(Node.UpgradeName)/@Node.MaxAmount</div>
									}
									@if (IsUpgradeOwned && GetLevel(Node.UpgradeName) == Node.MaxAmount)
									{
										<div class="check"><i>check</i></div>
									}
								</div>
							</div>
						}
					</div>
				</div>

				<!-- Zoom Controls -->
				<div class="zoom-controls" @onwheel="OnMouseWheel">
					<div class="btn" @onclick="@(() => { Scale = Math.Min(Scale + 0.2f, 3f); })"><i>add</i></div>
					<div class="btn" @onclick="@(() => { Scale = Math.Max(Scale - 0.2f, 0.2f); })"><i>remove</i></div>
					<div class="btn zoom-scale" @onclick="@(() => { Scale = 1f; })">@Scale.ToString("F1")x</div>
					<div class="btn" @onclick="@(() => { CanvasX = -225f; CanvasY = 0f; Scale = 1f; })"><i>home</i></div>
				</div>

				<!-- Sidebar Info -->
				@if (SelectedUpgrade != null)
				{
					<div class="sidebar">
						<div class="close-sidebar" @onclick=@(() => { SelectedUpgradeName = EUpgradeName.None; })><i>close</i></div>

						<h2>@SelectedUpgrade.Name</h2>

						<p class="desc">@GetDynamicDescription(SelectedUpgrade)</p>
						@if (SelectedUpgrade.UpgradeValue != EUpgradeValue.None)
						{
							<div class="stat-row">
								<span>CURRENT VALUE</span>
								<span class="text-white">@GetFormattedUpgradeValue(SelectedUpgrade.UpgradeValue)</span>
							</div>
						}
						<div class="stat-row">
							<span>UPGRADE COST</span>
							<span class="@(CanAfford(SelectedUpgrade) || GetIsOwned(SelectedUpgradeName) ? "text-white" : "text-red")">$@GetCurrentCost(SelectedUpgrade)</span>
						</div>
						<div class="stat-row">
							<span>LEVEL</span>
							<span class="text-white">@GetLevel(SelectedUpgradeName) / @SelectedUpgrade.MaxAmount</span>
						</div>
						<div class="divider"></div>
						<div class="stat-row">
							<span>REQUIREMENTS</span>
							<span class="text-white">@(SelectedUpgrade.ParentsUpgradeNames.Count > 0 ? $"{SelectedUpgrade.ParentsUpgradeNames.Count} Links" : "None")</span>
						</div>
						<div class="buy-section">
							@if (!CanBuyMore(SelectedUpgrade))
							{
								<div class="buy-btn">MAXED OUT</div>
							}
							else
							{
								<div class="buy-btn @(CanAfford(SelectedUpgrade) && GetIsAvailable(SelectedUpgradeName) ? "active" : "disabled")" @onclick=@BuyUpgrade>
									@(!GetIsAvailable(SelectedUpgradeName) ? "LOCKED" : CanAfford(SelectedUpgrade) ? "BUY UPGRADE" : "INSUFFICIENT MONEY")
								</div>
							}
						</div>
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	[Property] private List<Upgrade> Upgrades { get; set; } = [];
	[Property, ImageAssetPath] private string QuestionMarkIcon { get; set; }
	private bool IsDragging;
    private EUpgradeName SelectedUpgradeName;
    private float CanvasX = -225f;
    private float CanvasY;
    private float Scale = 1f;
    private Vector2 DragStartPos;
    private Vector2 DragStartOffset;
    private PlayerData PlayerData; 
	// --------------------------------------------------------------PROTECTED METHODS--------------------------------------------------------------
    protected override void OnMouseWheel(Vector2 InValue)
    {
	    if (InValue.y < 0) Scale = Math.Min(Scale + 0.2f, 2.4f);
	    else if (InValue.y > 0) Scale = Math.Max(Scale - 0.2f, 0.6f);
    }
    protected override void OnAwake()
    {
	    EventManager.OnUiStateChanged += UiStateChanged;
    }
    protected override void OnStart() { PlayerData = EventManager.TriggerGetPlayerData(); }
    protected override void OnDestroy()
    {
	    EventManager.OnUiStateChanged -= UiStateChanged;
    }
    protected override int BuildHash()
    {
	    return HashCode.Combine(PlayerData.GetMoney(), SelectedUpgradeName, Scale, CanvasX, CanvasY, PlayerData.GetOwnedUpgrades().Count, IsDragging);
    }
    protected override void OnUpdate()
    {
	    if (!IsDragging) return;
	    Vector2 Delta = Mouse.Position - DragStartPos;
	    CanvasX = DragStartOffset.x + Delta.x / Scale;
	    CanvasY = DragStartOffset.y + Delta.y / Scale;
    }
	// --------------------------------------------------------------PRIVATE METHODS--------------------------------------------------------------
	private bool CanAfford(Upgrade InUpgrade)
	{
		return InUpgrade != null && PlayerData.GetMoney() >= GetCurrentCost(InUpgrade);
	}
	private Upgrade SelectedUpgrade => Upgrades.FirstOrDefault(U => U.UpgradeName == SelectedUpgradeName);
	private bool GetIsAvailable(EUpgradeName InUpgradeName)
	{
		Upgrade Upgrade = Upgrades.FirstOrDefault(U => U.UpgradeName == InUpgradeName);
		if (Upgrade == null) return false;
		return Upgrade.ParentsUpgradeNames.Count == 0 || Upgrade.ParentsUpgradeNames.All(GetIsOwned);
	}
	private bool GetIsOwned(EUpgradeName InUpgradeName) => GetLevel(InUpgradeName) > 0;
	private bool CanBuyMore(Upgrade InUpgrade) 
	{
		return InUpgrade != null && GetLevel(InUpgrade.UpgradeName) < InUpgrade.MaxAmount;
	}
	private int GetLevel(EUpgradeName InUpgradeName) => PlayerData.GetOwnedUpgrades().GetValueOrDefault(InUpgradeName, 0);
	private int GetCurrentCost(Upgrade InUpgrade)
	{
		if (InUpgrade?.Costs == null || InUpgrade.Costs.Count == 0) return 0;
		int CurrentLevel = GetLevel(InUpgrade.UpgradeName);
		return CurrentLevel >= InUpgrade.MaxAmount ? InUpgrade.Costs.Last() : InUpgrade.Costs[CurrentLevel];
	}
	private float GetUpgradeValue(EUpgradeValue InUpgradeValue)
	{
		if (PlayerData == null) return 0;
		switch (InUpgradeValue)
		{
			case EUpgradeValue.MoneyAdded: return 1 + PlayerData.GetUpgradeAmount(EUpgradeName.MoreMoney1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.MoreMoney1);
			case EUpgradeValue.MovementSpeed: return 100 + PlayerData.GetUpgradeAmount(EUpgradeName.MovementSpeed1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.MovementSpeed1);
			case EUpgradeValue.BoxGrabRange: return 100 + PlayerData.GetUpgradeAmount(EUpgradeName.BoxGrabRange1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.BoxGrabRange1);
			case EUpgradeValue.SwordPower: return 100 + PlayerData.GetUpgradeAmount(EUpgradeName.SwordPower1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.SwordPower1);
			case EUpgradeValue.MoneyLoss: return GlobalData.Instance.GetDefaultAttributeValue(EDefaultAttribute.MoneyLossPercentageToAliens) - PlayerData.GetUpgradeAmount(EUpgradeName.LessMoneyLoss1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.LessMoneyLoss1);
			case EUpgradeValue.DashCooldown: return GlobalData.Instance.GetDefaultAttributeValue(EDefaultAttribute.DashCooldown) - PlayerData.GetUpgradeAmount(EUpgradeName.DashCooldown1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.DashCooldown1);
			case EUpgradeValue.DashImpulseStrength: return 100 + PlayerData.GetUpgradeAmount(EUpgradeName.DashImpulseStrength1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.DashImpulseStrength1);
			case EUpgradeValue.BoxThrowStrength: return 100 + PlayerData.GetUpgradeAmount(EUpgradeName.BoxThrowImpulseStrength1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.BoxThrowImpulseStrength1);
			case EUpgradeValue.ChanceToSpawnWood: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnWood1, EUpgradeName.ChanceToSpawnRock1);
			case EUpgradeValue.ChanceToSpawnRock: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnRock1, EUpgradeName.ChanceToSpawnMetal1);
			case EUpgradeValue.ChanceToSpawnMetal: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnMetal1, EUpgradeName.ChanceToSpawnGold1);
			case EUpgradeValue.ChanceToSpawnGold: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnGold1, EUpgradeName.ChanceToSpawnDiamond1);
			case EUpgradeValue.ChanceToSpawnDiamond: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnDiamond1, EUpgradeName.ChanceToSpawnRuby1);
			case EUpgradeValue.ChanceToSpawnRuby: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnRuby1, EUpgradeName.ChanceToSpawnEmerald1);
			case EUpgradeValue.ChanceToSpawnEmerald: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnEmerald1, EUpgradeName.ChanceToSpawnAmethyst1);
			case EUpgradeValue.ChanceToSpawnAmethyst: return CalculateBoxSpawnChance(EUpgradeName.ChanceToSpawnAmethyst1, EUpgradeName.ChanceToSpawnObsidian1);
			case EUpgradeValue.ChanceToSpawnObsidian: return PlayerData.GetUpgradeAmount(EUpgradeName.ChanceToSpawnObsidian1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.ChanceToSpawnObsidian1);
			case EUpgradeValue.AlienComboMaxMultiplier: return PlayerData.GetUpgradeAmount(EUpgradeName.AlienComboMaxMultiplier1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.AlienComboMaxMultiplier1);
			case EUpgradeValue.AlienComboMultiplierBoxReduction: return GlobalData.Instance.GetDefaultAttributeValue(EDefaultAttribute.RequiredBoxesAmountForAlienBoxCombo1) - PlayerData.GetUpgradeAmount(EUpgradeName.AlienComboMultiplierBoxReduction1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.AlienComboMultiplierBoxReduction1);
			case EUpgradeValue.BiggerAlienMoreMoneyMultiplier: return PlayerData.GetUpgradeAmount(EUpgradeName.BiggerAlienMoreMoneyMultiplier1) * GlobalData.Instance.GetUpgradeValue(EUpgradeName.BiggerAlienMoreMoneyMultiplier1);
			default: return 0;
		}
	}
	private float CalculateBoxSpawnChance(EUpgradeName InUpgradeName, EUpgradeName InUpgradeNextTierName)
	{
		float CurrentMultiplier = GlobalData.Instance.GetUpgradeValue(InUpgradeName);
		float NextMultiplier = GlobalData.Instance.GetUpgradeValue(InUpgradeNextTierName);
		return PlayerData.GetUpgradeAmount(InUpgradeName) * CurrentMultiplier + PlayerData.GetUpgradeAmount(InUpgradeNextTierName) * NextMultiplier;
	}
	private string GetFormattedUpgradeValue(EUpgradeValue InUpgradeValue)
	{
		float Value = GetUpgradeValue(InUpgradeValue);
		string Formatted = Value.ToString("G");
		switch (InUpgradeValue)
		{
			case EUpgradeValue.MoneyAdded: case EUpgradeValue.AlienComboMultiplierBoxReduction: return Formatted;
			case EUpgradeValue.DashCooldown: return $"{Formatted}s";
			case EUpgradeValue.BiggerAlienMoreMoneyMultiplier: case EUpgradeValue.AlienComboMaxMultiplier: return $"{Formatted}x";
			default: return $"{Formatted}%";
		}
	}
	
	private void OnMouseDragged()
	{
		IsDragging = true;
		DragStartPos = Mouse.Position;
		DragStartOffset = new Vector2(CanvasX, CanvasY);
	}
	private void OnMouseReleased() { IsDragging = false; }
	private void SelectNode(EUpgradeName InUpgradeName) { SelectedUpgradeName = InUpgradeName; }
	private void BuyUpgrade()
	{
		if (SelectedUpgradeName == EUpgradeName.None || SelectedUpgrade == null || !CanBuyMore(SelectedUpgrade) || !CanAfford(SelectedUpgrade) || !GetIsAvailable(SelectedUpgradeName)) return;
		PlayerData.SubtractMoney(GetCurrentCost(SelectedUpgrade));
		PlayerData.BuyUpgrade(SelectedUpgradeName);
	}
	private void CloseMenu() { UiManager.ChangeUiState(EUi.UpgradesMenu); }
	private void UiStateChanged(EUi InUi, bool RenderState)
	{
		if (InUi != EUi.UpgradesMenu) return;
		Enabled = RenderState;
		Panel?.Style.PointerEvents = Enabled ? PointerEvents.All : PointerEvents.None;
	}
	private string GetDynamicDescription(Upgrade InUpgrade)
	{
		return InUpgrade == null ? "" : InUpgrade.Description
			.Replace("{0}", GlobalData.Instance.GetUpgradeValue(InUpgrade.UpgradeName).ToString("G"))
			.Replace("{1}", GlobalData.Instance.GetDefaultAttributeValue(InUpgrade.DefaultAttribute).ToString("G"));
	}
	
	[Button("Reset Save File"), Group("Dev Tools")]
	public void ResetSave()
	{
		if (!Game.IsEditor) return;
		if (FileSystem.Data.FileExists("save.dat")) FileSystem.Data.DeleteFile("save.dat");
		else Log.Warning("No save file found to delete.");
	}
	[Property, Group("Dev Tools")] 
	private float DebugMoneyAmount { get; set; } = 1000f;
	[Button("Add Money"), Group("Dev Tools")]
	public void AddMoney()
	{
		if (!Game.IsEditor || PlayerData == null) return;
		PlayerData.AddMoney(DebugMoneyAmount);
	}
	[Button("Remove Money"), Group("Dev Tools")]
	public void SubtractMoney()
	{
		if (!Game.IsEditor || PlayerData == null) return;
		PlayerData.SubtractMoney(DebugMoneyAmount);
	}
}
