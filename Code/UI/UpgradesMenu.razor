@using Sandbox;
@using Sandbox.Enums
@using Sandbox.Managers
@inherits PanelComponent
@using System;

<root>
    <div class="wrapper">
        <!-- Header -->
        <header>
            <div class="header-left">
                <div class="logo-box">
                    <i>emoji_events</i>
                </div>
                <div class="title-info">
                    <h1>SKILL TREE</h1>
                    <p>NEURAL_ARRAY_V2.0.4</p>
                </div>
            </div>

            <div class="header-right">
                <div class="money-info">
                    <span>AVAILABLE CREDITS</span>
                    <div class="money-amount">
                        <i>savings</i>
                        <span>$@Money</span>
                    </div>
                </div>
                <div class="code-btn" @onclick=@CloseMenu>
                    <i>close</i>
                </div>
            </div>
        </header>

        <!-- Canvas Workspace -->
        <div class="canvas-container">
            <!-- Background Drag Catcher (Removed mouse up/move from here, handled safely in OnUpdate) -->
            <div class="canvas-bg" @onmousedown=@OnMouseDragged @onmouseup=@OnMouseReleased></div>

            <!-- Transformable Canvas View -->
            <div class="canvas" style="transform: scale(@Scale) translate(@(CanvasX)px, @(CanvasY)px);">
                <!-- Connection Lines -->
                <div class="lines">
                    @foreach (Upgrade Node in Upgrades)
                    {
                        @foreach (string ParentId in Node.Parents)
                        {
                            Upgrade Parent = Upgrades.FirstOrDefault(U => U.Id == ParentId);
                            if (Parent == null) continue;
                            float Dx = Node.X - Parent.X;
                            float Dy = Node.Y - Parent.Y;
                            float Length = MathF.Sqrt(Dx * Dx + Dy * Dy);
                            float Angle = MathF.Atan2(Dy, Dx) * 180f / MathF.PI;
                            bool IsOwnedPath = GetIsOwned(Node.Id) && GetIsOwned(Parent.Id);

                            <div class="line @(IsOwnedPath ? "owned" : "unowned")" 
                                 style="left: @(Parent.X)px; top: @(Parent.Y)px; width: @(Length)px; transform: rotate(@(Angle)deg);"></div>
                        }
                    }
                </div>

                <!-- Upgrade Nodes -->
                <div class="nodes">
                    @foreach (Upgrade Node in Upgrades)
                    {
                        bool IsSelected = SelectedId == Node.Id;
                        bool IsOwned = GetIsOwned(Node.Id);
                        bool IsAvailable = GetIsAvailable(Node.Id);

                        <div class="node-wrapper @(IsSelected ? "selected" : "")" 
                             style="left: @(Node.X)px; top: @(Node.Y)px;" 
                             @onclick=@(() => SelectNode(Node.Id))>
                            
                            <div class="node @(IsOwned ? "owned" : "") @(IsAvailable ? "available" : "locked") @Node.Category">
                                <i>@Node.Icon</i>
                                @if (IsOwned)
                                {
                                    <div class="check"><i>check</i></div>
                                }
                            </div>
                            <div class="node-label">@Node.Name</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Zoom Controls -->
            <div class="zoom-controls" @onwheel="OnMouseWheel">
                <div class="btn" @onclick="@(() => { Scale = Math.Min(Scale + 0.2f, 3f); })"><i>add</i></div>
                <div class="btn" @onclick="@(() => { Scale = Math.Max(Scale - 0.2f, 0.2f); })"><i>remove</i></div>
                <div class="btn text" @onclick="@(() => { Scale = 1f; })">@Scale.ToString("F1")x</div>
                <div class="btn" @onclick="@(() => { CanvasX = -225f; CanvasY = 0f; Scale = 1f; })"><i>home</i></div>
            </div>

            <!-- Sidebar Info -->
            @if (SelectedUpgrade != null)
            {
                <div class="sidebar">
                    <div class="close-sidebar" @onclick=@(() => { SelectedId = null; StateHasChanged(); })><i>close</i></div>
                    
                    <div class="sidebar-icon @SelectedUpgrade.Category">
                        <i>@SelectedUpgrade.Icon</i>
                    </div>
                    
                    <h2>@SelectedUpgrade.Name</h2>
                    
                    <div class="badges">
                        <span class="badge @SelectedUpgrade.Category">@SelectedUpgrade.Category.ToUpper()</span>
                        @if (GetIsOwned(SelectedId))
                        {
                            <span class="badge owned"><i style="font-size: 12px; margin-right: 4px;">check</i> PURCHASED</span>
                        }
                    </div>

                    <p class="desc">@SelectedUpgrade.Description</p>

                    <div class="stats">
                        <div class="stat-row">
                            <span>UPGRADE COST</span>
                            <span class="@(CanAfford || GetIsOwned(SelectedId) ? "text-white" : "text-red")">$@SelectedUpgrade.Cost</span>
                        </div>
                        <div class="divider"></div>
                        <div class="stat-row">
                            <span>REQUIREMENTS</span>
                            <span class="text-white">@(SelectedUpgrade.Parents.Count > 0 ? $"{SelectedUpgrade.Parents.Count} Linked" : "None")</span>
                        </div>
                    </div>

                    <div class="buy-section">
                        @if (GetIsOwned(SelectedId))
                        {
                            <div class="status-box owned">ALREADY INSTALLED</div>
                        }
                        else
                        {
                            <div class="buy-btn @(CanAfford && GetIsAvailable(SelectedId) ? "active" : "disabled")" @onclick=@BuyUpgrade>
                                @(!GetIsAvailable(SelectedId) ? "LOCKED" : CanAfford ? "PURCHASE UPGRADE" : "INSUFFICIENT CREDITS")
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <footer>
            <div class="tips">
                <div class="tip"><i>ads_click</i> CLICK NODES TO SELECT</div>
                <div class="tip"><i>navigation</i> @Upgrades.Count UPGRADES AVAILABLE</div>
            </div>
            <div class="progress-info">
                <div class="progress-bar">
                    <div class="fill combat" style="width: @(GetProgress("combat"))%"></div>
                    <div class="fill mobility" style="width: @(GetProgress("mobility"))%"></div>
                    <div class="fill resource" style="width: @(GetProgress("resource"))%"></div>
                </div>
                <span class="power-text">SYSTEM POWER: @Math.Round((float)OwnedUpgrades.Count / Math.Max(1, Upgrades.Count) * 100)%</span>
            </div>
        </footer>
    </div>
</root>

@code
{
	public class Upgrade
	{
		public string Id;
		public string Name;
		public string Description;
		public int Cost;
		public List<string> Parents = [];
		public string Icon;
		public string Category;
		public float X;
		public float Y;
	}
	
	public struct CategoryData
	{
		public string Key;
		public string Name;
		public string Icon;
		public float Dx;
		public float Dy;
	}
	
	// === Logic & State ===
	private bool IsDragging;
    private int Money = 1500;
    private float CanvasX = -225f;
    private float CanvasY;
    private float Scale = 1f;
    private string SelectedId = "root";
    private Vector2 DragStartPos;
    private Vector2 DragStartOffset;
    private List<Upgrade> Upgrades = [];
    private readonly HashSet<string> OwnedUpgrades = ["root"];

    private bool CanAfford => SelectedUpgrade != null && Money >= SelectedUpgrade.Cost;
    private Upgrade SelectedUpgrade => Upgrades.FirstOrDefault( U => U.Id == SelectedId );

    public bool GetIsAvailable(string InId)
    {
        Upgrade Upgrade = Upgrades.FirstOrDefault(U => U.Id == InId);
        if (Upgrade == null) return false;
        return Upgrade.Parents.Count == 0 || Upgrade.Parents.Any(ParentId => OwnedUpgrades.Contains(ParentId));
    }
    public bool GetIsOwned(string InId) => OwnedUpgrades.Contains(InId);
    public float GetProgress(string InCategory)
    {
	    int Max = InCategory == "resource" ? 10 : 15;
	    int Count = OwnedUpgrades.Count(CategoryId => CategoryId.StartsWith(InCategory));
	    return Math.Clamp((float)Count / Max * 100f, 0, 100);
    }

    public void SelectNode(string InId)
    {
        SelectedId = InId;
        StateHasChanged();
    }
    public void BuyUpgrade()
    {
	    if (SelectedId == null || SelectedUpgrade == null || GetIsOwned(SelectedId) || !CanAfford || !GetIsAvailable(SelectedId)) return;
	    Money -= SelectedUpgrade.Cost;
	    OwnedUpgrades.Add( SelectedId );
	    StateHasChanged();
    }
    public void CloseMenu() { UiManager.TriggerUiStateChange(EUi.UpgradesMenu); }
    // ------------------------------------------------------------------------------------- VIRTUAL METHODS ---------------------------------------------------------------------------
    protected override void OnStart()
    {
	    GenerateUpgrades();
	    EventManager.OnUiStateChanged += UiStateChanged;
	    Enabled = false;
    }
    protected override void OnDestroy()
    {
	    EventManager.OnUiStateChanged -= UiStateChanged;
    }
    protected override int BuildHash()
    {
	    return HashCode.Combine( Money, SelectedId, Scale, CanvasX, CanvasY ) ^ HashCode.Combine( OwnedUpgrades.Count, IsDragging );
    }
    protected override void OnUpdate()
    {
	    // 2. Reliable Dragging Processing
	    if (!IsDragging) return;
	    // Moved to standard modern 'Mouse.Position' rather than old Sandbox.Mouse
	    Vector2 Delta = Mouse.Position - DragStartPos;
	    CanvasX = DragStartOffset.x + Delta.x / Scale;
	    CanvasY = DragStartOffset.y + Delta.y / Scale;
	    StateHasChanged();
    }

    // === Dragging Events ===

    public void OnMouseDragged()
    {
        IsDragging = true;
        DragStartPos = Mouse.Position;
        DragStartOffset = new Vector2( CanvasX, CanvasY );
    }
    public void OnMouseReleased() { IsDragging = false; }

    // === Generation Logic ===

    private void GenerateUpgrades()
    {
		Upgrades =
        [
	        new Upgrade
	        {
		        Id = "root",
		        Name = "Neural Link",
		        Description = "The base connection to the upgrade network.",
		        Cost = 0,
		        Icon = "memory",
		        Category = "utility",
		        X = 0,
		        Y = 0
	        }

        ];
        List<CategoryData> Categories =
        [
	        new()
	        {
		        Key = "combat",
		        Name = "Combat",
		        Icon = "swords",
		        Dx = -3f,
		        Dy = 1.5f
	        },
	        new()
	        {
		        Key = "mobility",
		        Name = "Mobility",
		        Icon = "air",
		        Dx = 3f,
		        Dy = 1.5f
	        },
	        new()
	        {
		        Key = "resource",
		        Name = "Resource",
		        Icon = "paid",
		        Dx = -3f,
		        Dy = -1.5f
	        },
	        new()
	        {
		        Key = "utility",
		        Name = "Utility",
		        Icon = "build",
		        Dx = 3f,
		        Dy = -1.5f
	        }
        ];

        string[] IconPool = ["bolt", "shield", "skull", "local_fire_department", "my_location", "science", "star", "rocket", "handyman", "monitor_heart", "emoji_events", "inventory_2", "public", "favorite", "lightbulb", "explore", "terminal", "military_tech", "cyclone"];

        for (int CatIdx = 0; CatIdx < Categories.Count; CatIdx++)
        {
            CategoryData Cat = Categories[CatIdx];
            string T1Id = $"{Cat.Key}_tier1";
            Upgrades.Add( new Upgrade { 
                Id = T1Id, Name = $"{Cat.Name} Specialist", Description = $"Basic level of {Cat.Name.ToLower()} training.", 
                Cost = 100, Parents = ["root"], Icon = Cat.Icon, Category = Cat.Key, 
                X = Cat.Dx * 180, Y = Cat.Dy * 180 
            });
            for (int I = 0; I < 3; I++)
            {
                string SubId = $"{Cat.Key}_sub_{I}";
                Upgrades.Add( new Upgrade { 
                    Id = SubId, Name = $"{Cat.Name} Skill {I + 1}", Description = $"Enhance your {Cat.Name.ToLower()} efficiency.", 
                    Cost = 250, Parents = [T1Id], Icon = IconPool[(CatIdx * 5 + I) % IconPool.Length], Category = Cat.Key, 
                    X = Cat.Dx * 180 + (I - 1) * 220, Y = Cat.Dy * 180 + (Cat.Dy * 180) 
                });

                for (int J = 0; J < 3; J++)
                {
                    string DeepId = $"{SubId}_deep_{J}";
                    Upgrades.Add( new Upgrade { 
                        Id = DeepId, Name = $"{Cat.Name} Mastery {I + 1}.{J + 1}", Description = $"Master level refinement for {Cat.Name.ToLower()}.", 
                        Cost = 500 + (J * 100), Parents = [SubId], Icon = IconPool[(CatIdx * 7 + I * 3 + J) % IconPool.Length], Category = Cat.Key, 
                        X = Cat.Dx * 180 + (I - 1) * 220 + (J - 1) * 140, Y = Cat.Dy * 180 + (Cat.Dy * 180) + (Cat.Dy * 180) 
                    });
                }
            }
        }
    }

    protected override void OnMouseWheel(Vector2 InValue)
    {
	    base.OnMouseWheel(InValue);
	    if (InValue.y < 0) Scale = Math.Min(Scale + 0.2f, 3f);
	    else if (InValue.y > 0) Scale = Math.Max(Scale - 0.2f, 0.2f);
    }

	private void UiStateChanged(EUi InUi, bool RenderState)
	{
		if (InUi != EUi.UpgradesMenu) return;
		Enabled = RenderState;
		Panel?.Style.PointerEvents = Enabled ? PointerEvents.All : PointerEvents.None;
	}
}
