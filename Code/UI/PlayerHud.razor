@using Sandbox;
@using Sandbox.Managers
@inherits PanelComponent

<root>
	<div class = "Info" >
		<p>@Text</p>
	</div>
</root>

@code
{
	string Text = "Hello";
	protected override void OnStart()
	{
		Scene.GetSystem<EventManager>().OnPlayerClickStateChange += HandleClickStateChange;
	}
	protected override void OnDestroy()
	{
		Scene.GetSystem<EventManager>().OnPlayerClickStateChange -= HandleClickStateChange;
	}
	void HandleClickStateChange(float MouseClickState)
	{
		Text = MouseClickState == 1f ? "Clicked!" : "Released";
	}
	protected override int BuildHash()
	{
		return System.HashCode.Combine(Text);
	}
}
