@using Sandbox;
@using Sandbox.Data
@using Sandbox.Enums
@using Sandbox.Managers
@inherits PanelComponent

<root>
	@if (PlayerRef != null)
	{
		<div class="crosshair-container">
			<div class="corner top-left"></div>
			<div class="corner top-right"></div>
			<div class="corner bottom-left"></div>
			<div class="corner bottom-right"></div>
		</div>
		<div class="quests-container">
			@{
				int DisplayedCount = 0; 
				PlayerData SaveData = PlayerRef.GetSaveData();
			}
			@foreach (KeyValuePair<EQuest, QuestData> Quest in GlobalData.Instance.AllQuestsData)
			{
				if (DisplayedCount >= 3) break;
				if (!SaveData.IsQuestCompleted(Quest.Key))
				{
					int CurrentProgress = SaveData.GetQuestProgress(Quest.Key);
					<div class="quest-item">
						<div class="quest-meta">
							<span class="quest-title">@Quest.Value.QuestText</span>
							<span class="quest-counter">@CurrentProgress / @Quest.Value.RequiredProgress</span>
						</div>
						<div class="quest-progress-bg">
							<div class="quest-progress-fill" style="width: @((float)CurrentProgress / @Quest.Value.RequiredProgress * 100f)%;"></div>
						</div>
					</div>
					DisplayedCount++;
				}
			}
		</div>
		<div class="vote-panel @(IsVoteActive ? "visible" : "")">
			<div class="vote-header">
				<span class="header-title">SERVER VOTE IN PROGRESS</span>
			</div>
			<div class="vote-body">
				<p class="vote-question">Reset all Aliens and Cubes?</p>
				<div class="vote-results">
					<div class="result-row">
						<span class="key-hint">[Y] YES</span>
						<div class="bar-bg">
							<div class="bar-fill yes" style="width: @(TotalVotes > 0 ? YesCount / (float)TotalVotes * 100f : 0f)%;"></div>
						</div>
						<span class="count-val">@YesCount</span>
					</div>
					<div class="result-row">
						<span class="key-hint">[N] NO</span>
						<div class="bar-bg">
							<div class="bar-fill no" style="width: @(TotalVotes > 0 ? NoCount / (float)TotalVotes * 100f : 0f)%;"></div>
						</div>
						<span class="count-val">@NoCount</span>
					</div>
				</div>
				<div class="timer-bar-wrapper">
					<div class="timer-bar-fill" style="width: @(System.Math.Clamp((1f - TimeSinceVoteStart / VoteDuration) * 100f, 0f, 100f))%;"></div>
				</div>
			</div>
		</div>
		@if (IsConnectionBad)
		{
			<div class="WifiWarning">
				<div class="IconWrapper">
					<label class="WifiIcon">wifi</label>
					<div class="RedSlash"></div>
				</div>
			</div>
		}
		@if (PlayerRef.GetIsDashPurchased())
		{
			<div class="ability-container">
				<div class="ability-box @(PlayerRef.GetIsDashAvailable() ? "ready" : "on-cooldown")">
					@if (PlayerRef.GetIsDashAvailable())
					{
						<span class="ability-text">DASH</span>
					}
					else
					{
						<div class="cooldown-overlay" style="height: @(PlayerRef.GetDashPercentage())%;"></div>
						<span class="cooldown-text">@PlayerRef.GetDashCooldown().ToString("F1")</span>
					}
				</div>
			</div>
		}
		<div class="Money">
			<div class="icon"><i>payments</i></div>
			<div class="amount-container">
				<span class="value">$@Money.ToString("N0")</span>
			</div>
		</div>
		@if (PurchasableAmountUpgrades > 0)
		{
			<div class="upgrade-indicator">
				<div class="glow-dot animate-pulse"></div>
				<span class="upgrade-text">UPGRADE AVAILABLE: @PurchasableAmountUpgrades</span>
			</div>
		}
		@if (IsStuckPopupEnabled)
		{
			<div class="Unstuck">
				<p>PRESS [U] TO UNSTUCK</p>
			</div>
		}
		@if (IsAlienBoxComboMultiplierAvailable)
		{
			<div class="AlienBoxComboMultiplier">
				<div>COMBO</div>
				<div>@AlienBoxComboMultiplier.ToString("F1") X</div>
			</div>
		}
		<footer>
			<div class="tips">
				<span class="tip"><b>LMB</b> ATTACK</span>
				<span class="divider">|</span>
				<span class="tip"><b>RMB</b> PICK UP BOX</span>
				<span class="divider">|</span>
				<span class="tip"><b>TAB</b> Open Upgrades</span>
				<span class="divider">|</span>
				<span class="tip"><b>ESC</b> Open Settings</span>
			</div>
		</footer>
	}
</root>

@code
{
	private bool IsStuckPopupEnabled;
	private bool IsAlienBoxComboMultiplierAvailable;
	private int RequestPlayerRefHandle;
	private int CheckLatencyHandle;
	private int PurchasableAmountUpgrades;
	private int QuestStateVersion;
	private float AlienBoxComboMultiplier;
	private double Money;
	private Player.Player PlayerRef;
	
	private bool IsVoteActive;
	private int YesCount;
	private int NoCount;
	private bool HasVoted;
	private const float VoteDuration = 20f;
	private RealTimeSince TimeSinceVoteStart;
	private int TotalVotes => YesCount + NoCount;
	
	private bool IsConnectionBad;
	private const int HighPingThreshold = 180;
	
	protected override int BuildHash()
	{
		if (PlayerRef == null) return -1;
		System.HashCode Hc = new();
		Hc.Add(Money);
		Hc.Add(IsStuckPopupEnabled);
		Hc.Add(AlienBoxComboMultiplier);
		Hc.Add(IsAlienBoxComboMultiplierAvailable);
		Hc.Add(PlayerRef.GetIsDashAvailable());
		Hc.Add(PlayerRef.GetDashCooldown());
		Hc.Add(PlayerRef.GetIsDashPurchased());
		Hc.Add(IsVoteActive);
		Hc.Add(YesCount);
		Hc.Add(NoCount);
		Hc.Add(IsConnectionBad);
		Hc.Add(PurchasableAmountUpgrades);
		Hc.Add(TimeSinceVoteStart);
		Hc.Add(QuestStateVersion);
		return Hc.ToHashCode();
	}
	
	protected override void OnStart()
	{
		EventManager.OnMoneyChanged += SetMoneyAmount;
		EventManager.OnStuckPopupStateChanged += StuckPopupStateChange;
		EventManager.OnAlienBoxComboChanged += SetAlienBoxCombo;
		EventManager.OnVotingStarted += StartVoteWindow;
		EventManager.OnPlayerVoteSubmitted += SubmitLocalVote;
		EventManager.OnUpgradesAvailableToBePurchased += SetPurchasableUpgradesAvailable;
		EventManager.OnQuestProgressed += OnQuestUiRefreshRequested;
		RequestPlayerRefHandle = TimerManager.AddTimer(RequestPlayerRefHandle, 1f / 60f, true, TryToGetPlayerRef);
		CheckLatencyHandle = TimerManager.AddTimer(CheckLatencyHandle, 1f, true, CheckLatency);
	}
	protected override void OnDestroy()
	{
		EventManager.OnMoneyChanged -= SetMoneyAmount;
		EventManager.OnStuckPopupStateChanged -= StuckPopupStateChange;
		EventManager.OnAlienBoxComboChanged -= SetAlienBoxCombo;
		EventManager.OnVotingStarted -= StartVoteWindow;
		EventManager.OnPlayerVoteSubmitted -= SubmitLocalVote;
		EventManager.OnUpgradesAvailableToBePurchased -= SetPurchasableUpgradesAvailable;
		EventManager.OnQuestProgressed -= OnQuestUiRefreshRequested;
		TimerManager.ClearTimer(RequestPlayerRefHandle);
	}
	protected override void OnUpdate()
	{
		if (!IsVoteActive) return;
		if (TimeSinceVoteStart <= VoteDuration) return;
		HasVoted = false;
		IsVoteActive = false;
		if (Networking.IsHost) ResolveFinalVote();
	}

	private void SetPurchasableUpgradesAvailable(int InAmount) { PurchasableAmountUpgrades = InAmount; }
	private void StuckPopupStateChange(bool InState) { IsStuckPopupEnabled = InState; }
	private void SetMoneyAmount(double InMoney) { Money = InMoney; }
	private void OnQuestUiRefreshRequested() { QuestStateVersion++; }
	private void CheckLatency()
	{
		if (Connection.Local == null) return;
		IsConnectionBad = Connection.Local.Ping > HighPingThreshold;
	}
	private void StartVoteWindow()
	{
		if (!EventManager.TriggerGetIsVotingAvailable() || IsVoteActive) return;
		BroadcastVotingStart();
		HasVoted = true;
	}
	private void ResolveFinalVote()
	{
		EventManager.TriggerVotingFinished();
		if (YesCount <= NoCount) return;
		EventManager.TriggerWorldReset();
	}
	private void SubmitLocalVote(bool InVoteOption)
	{
		if (HasVoted || !IsVoteActive) return;
		HasVoted = true;
		HostProcessPlayerVote(InVoteOption);
	}
	private void SetAlienBoxCombo(float InAlienBoxComboMultiplier)
	{
		AlienBoxComboMultiplier = InAlienBoxComboMultiplier + 1f;
		IsAlienBoxComboMultiplierAvailable = AlienBoxComboMultiplier >= 1.1f;
	}
	private void TryToGetPlayerRef()
	{
		PlayerRef = EventManager.TriggerGetPlayerRef();
		if (PlayerRef == null) return;
		TimerManager.ClearTimer(RequestPlayerRefHandle);
	}
	
	[Rpc.Host]
	private void HostProcessPlayerVote(bool InVoteOption)
	{
		if (InVoteOption) YesCount++;
		else NoCount++;
		BroadcastUpdateVotes(YesCount, NoCount);
	}
	
	[Rpc.Broadcast]
	private void BroadcastVotingStart()
	{
		YesCount = 1;
		NoCount = 0;
		TimeSinceVoteStart = 0;
		IsVoteActive = true;
	}
	[Rpc.Broadcast]
	private void BroadcastUpdateVotes(int InCurrentYes, int InCurrentNo)
	{
		YesCount = InCurrentYes;
		NoCount = InCurrentNo;
	}
}
