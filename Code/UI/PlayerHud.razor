@using Sandbox;
@using Sandbox.Data
@using Sandbox.Managers
@inherits PanelComponent

<root>
	<div class="crosshair-container">
		<div class="corner top-left"></div>
		<div class="corner top-right"></div>
		<div class="corner bottom-left"></div>
		<div class="corner bottom-right"></div>
	</div>
	<div class="Money">
		<p>MONEY: @Money.FloorToInt()</p>
	</div>
	@if (IsStuckPopupEnabled)
	{
		<div class="Unstuck">
			<p>PRESS [U] TO UNSTUCK</p>
		</div>
	}
	<div class="Leaderboard">
		@foreach (LeaderboardEntry Entry in Players)
		{
			<div class="Entry">
				<span class="Name">@Entry.Name</span>
				<span class="Money">@Entry.Money</span>
			</div>
		}
	</div>
</root>

@code
{
	private bool IsStuckPopupEnabled;
	private float Money;
	private List<LeaderboardEntry> Players = [];
	
	protected override void OnStart()
	{
		EventManager.OnPlayerConnectionChanged += HandleClickStateChange;
		EventManager.OnMoneyChanged += SetMoneyAmount;
		EventManager.OnStuckPopupStateChanged += StuckPopupStateChange;
	}
	protected override void OnDestroy()
	{
		EventManager.OnPlayerConnectionChanged -= HandleClickStateChange;
		EventManager.OnMoneyChanged -= SetMoneyAmount;
		EventManager.OnStuckPopupStateChanged -= StuckPopupStateChange;
	}
	protected override int BuildHash()
	{
		return System.HashCode.Combine(Money, IsStuckPopupEnabled);
	}
	
	private void HandleClickStateChange(LeaderboardEntry InLeaderboardEntry, bool InConnected)
	{
		if (InConnected) Players.Add(InLeaderboardEntry);
		else Players.Remove(InLeaderboardEntry);
	}
	private void StuckPopupStateChange(bool InState) { IsStuckPopupEnabled = InState; }
	private void SetMoneyAmount(float InMoney) { Money = InMoney; }
}
