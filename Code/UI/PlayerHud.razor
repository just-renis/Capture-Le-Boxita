@using Sandbox;
@using Sandbox.Data
@using Sandbox.Managers
@inherits PanelComponent

<root>
	<div class = "Leaderboard" >
		@foreach (LeaderboardEntry Entry in Players)
		{
			<div class = "Entry">
				<span class = "Name">@Entry.Name</span>
				<span class = "Money">@Entry.Money</span>
			</div>
		}
	</div>
</root>

@code
{
	List<LeaderboardEntry> Players = new();
	protected override void OnStart()
	{
		Scene.GetSystem<EventManager>().OnPlayerConnectionChanged += HandleClickStateChange;
	}
	protected override void OnDestroy()
	{
		Scene.GetSystem<EventManager>().OnPlayerConnectionChanged -= HandleClickStateChange;
	}
	void HandleClickStateChange(LeaderboardEntry InLeaderboardEntry, bool InConnected)
	{
		if (InConnected) Players.Add(InLeaderboardEntry);
		else Players.Remove(InLeaderboardEntry);
	}
	protected override int BuildHash()
	{
		return System.HashCode.Combine(Players);
	}
}
