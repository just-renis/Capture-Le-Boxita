@using Sandbox.Managers
@inherits PanelComponent
@namespace Sandbox

<root>
	@if (ShouldRender())
	{
		<div class="name">@Name</div>
	}
</root>

@code
{
	[Sync] private string Name { get; set; }
	private bool IsVisible;
	private int CullingDistanceHandle;
		
	public void SetName(string InName) { Name = InName; }
	public void SetShowNameTag(bool InState) { IsVisible = InState; }
	
	protected override int BuildHash() { return System.HashCode.Combine(Name, IsVisible); }

	protected override void OnStart()
	{
		CullingDistanceHandle = TimerManager.AddTimer(CullingDistanceHandle, 1f, true, CheckIfInCullingDistance);
	}
	protected override void OnDestroy()
	{
		TimerManager.ClearTimer(CullingDistanceHandle);
	}

	private bool ShouldRender() { return IsProxy || IsVisible; }

	private void CheckIfInCullingDistance()
	{
		bool ShouldBeEnabled = Vector3.DistanceBetweenSquared(WorldPosition, EventManager.TriggerGetPlayerLocation()) < 5000000f;
		if (ShouldBeEnabled != Enabled) Enabled = ShouldBeEnabled;
	}
}
